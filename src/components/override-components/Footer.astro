---
import config from "@/config/config.json";
import social from "@/config/social.json";
import { Icon } from "@astrojs/starlight/components";
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";

const locale = Astro.currentLocale;

const menu = await getTranslations(locale || "en");

const footer = menu.footer;
const currentLocal = Astro.currentLocale || "en";
---

<footer>
  <div class="container">
    <div class="top-footer">
      {
        footer.community && (
          <div>
            <h4>{footer.community.title}</h4>
            <ul>
              {footer.community?.links.map((link: any) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        config?.params?.footer_contact?.enable && (
          <div>
            <h4>關於我</h4>

            <ul class="social-icons">
              {social.main.map((item) => (
                <li>
                  <a href={item.href} aria-label={item.label} target="_blank">
                    <Icon
                      name={item?.icon as any}
                      color="var(--sl-color-white)"
                      size="20px"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <div class="bottom-footer">
      <p
        set:html={`
        © ${new Date().getFullYear()} Super Easy CSS 
        <a class="text-primary hover:underline no-underline" href="https://im1010ioio.dev">@im1010ioio</a>
        .<br>
        <small>${markdownify(config?.params?.copyright)}</small>`}
      />
      <a href="privacy">隱私權聲明</a>
    </div>
  </div>
</footer>

<style>
  @layer starlight.core {
    .top-footer {
      border-bottom: 1px solid var(--sl-color-gray-6);
      padding: 1rem;
      display: flex;
      gap: 4rem;
      justify-content: space-between;
    }
    .top-footer h4 {
      font-size: 1rem !important;
      margin-bottom: 2rem;
    }
    .top-footer ul:not(.social-icons) {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      gap: 0 4rem;
    }
    .top-footer ul:not(.social-icons) li {
      margin-bottom: 1.2rem;
    }
    .top-footer ul:not(.social-icons) li a {
      color: var(--sl-color-text);
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.3s ease;
    }
    .top-footer ul:not(.social-icons) li a:hover {
      color: var(--color-primary);
    }

    @media (max-width: 768px) {
      .top-footer {
        flex-direction: column;
      }
      .top-footer ul:not(.social-icons) {
        grid-template-rows: auto;
        grid-auto-flow: row;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem 1rem;
      }
    }

    @media (max-width: 480px) {
      .top-footer ul:not(.social-icons) {
        grid-template-columns: 1fr;
      }
    }
    .mail-form {
      border: 1px solid var(--sl-color-gray-6);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 12px;
      padding: 0.5rem 0.8rem;
      background-color: var(--sl-color-black);
    }
    .mail-form input {
      background-color: transparent;
      width: 90%;
    }
    .mail-form input:focus {
      outline: none;
    }
    .mail-form button {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: transparent;
      cursor: pointer;
    }
    .social-icons {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      flex-wrap: wrap;
      padding: 0;
      list-style: none;
    }
    .social-icons li a {
      background: color-mix(in srgb, var(--sl-color-gray-4) 20%, transparent);
      width: 45px;
      height: 45px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.6s ease;
    }
    .social-icons li a:hover {
      background: var(--color-primary-gradient);
      color: white !important;
    }

    .bottom-footer {
      padding: 1rem;
      border-top: 1px solid var(--sl-color-hairline);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .bottom-footer a {
      color: var(--sl-color-text);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .bottom-footer a:hover {
      color: var(--color-primary);
    }
  }
</style>
